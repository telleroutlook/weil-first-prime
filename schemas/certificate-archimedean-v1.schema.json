{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "certificate-archimedean-v1",
  "title": "Archimedean primitives certificate",
  "description": "Dual-path certificate for M_V, M_K, S_VV, S_VK, S_KK at L=7/20. Carries only frozen identities and parameter hashes. All matrix values are recomputed by the checker; self-reported numeric fields are rejected as unknown.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "obligation",
    "radius",
    "sector",
    "index_set",
    "path_a",
    "path_b",
    "theorem_contract_sha256"
  ],
  "properties": {
    "format_version": {
      "type": "string",
      "const": "archimedean-1.0"
    },
    "obligation": {
      "type": "string",
      "const": "archimedean_primitives_o2_v1"
    },
    "sector": {
      "type": "string",
      "enum": ["even", "odd"]
    },
    "index_set": {
      "type": "array",
      "items": {"type": "integer"},
      "minItems": 1
    },
    "radius": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer", "const": 7},
        "denominator": {"type": "integer", "const": 20}
      }
    },
    "path_a": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "quadrature_rule",
        "remainder_method",
        "integrand_source_sha256"
      ],
      "properties": {
        "method": {"type": "string", "const": "GL_with_certified_remainder"},
        "quadrature_rule": {"type": "string", "enum": ["GL8", "GL14", "GL16"]},
        "remainder_method": {
          "type": "string",
          "const": "bernstein_ellipse_analytic"
        },
        "integrand_source_sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "path_b": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "taylor_cutoff",
        "taylor_cubic_coefficient",
        "remainder_method",
        "integrand_source_sha256"
      ],
      "properties": {
        "method": {"type": "string", "const": "taylor_plus_GL_with_certified_remainder"},
        "taylor_cutoff": {"type": "string"},
        "taylor_cubic_coefficient": {
          "type": "object",
          "additionalProperties": false,
          "required": ["numerator", "denominator"],
          "properties": {
            "numerator": {"type": "integer", "const": 7},
            "denominator": {"type": "integer", "const": 11520}
          },
          "description": "Correct coefficient 7/11520 for the s^3 term. NOT 1/2880."
        },
        "remainder_method": {
          "type": "string",
          "const": "bernstein_ellipse_analytic"
        },
        "integrand_source_sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "theorem_contract_sha256": {"$ref": "#/definitions/sha256"},
    "mk_entries": {
      "type": "array",
      "description": "Witness records for each M_K entry: path_a and path_b interval bounds and intersection result.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["n_row", "n_col", "path_a", "path_b", "intersects"],
        "properties": {
          "n_row": {"type": "integer"},
          "n_col": {"type": "integer"},
          "path_a": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2},
          "path_b": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2},
          "intersects": {"type": "boolean"}
        }
      }
    }
  },
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
