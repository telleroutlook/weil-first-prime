{
  "BRIDGE_CHECKER": "python3 checker/first_prime/check_first_prime_certificate.py",
  "BRIDGE_CHECKER_ARCHIMEDEAN": "python3 checker/archimedean/check_archimedean.py",
  "PROOFCTL_ADAPTERS": "${PROOFCTL_ROOT}/adapters",
  "_note": "Copy this file to .proofctl/env.json and set PROOFCTL_ROOT to your proofctl checkout path. proofctl auto-loads .proofctl/env.json at startup so BRIDGE_CHECKER is set in every session without manual export."
}
